{
  "name": "netplan-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @netplan/server --filter @netplan/web dev",
    "start": "pnpm build && cross-env NETPLAN_SERVE_WEB=1 pnpm --filter @netplan/server start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @netplan/web test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "seed": "pnpm --filter @netplan/web seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript": "catalog:",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
