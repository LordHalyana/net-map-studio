{
  "name": "@netplan/import-contract",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The canonical NetPlan Studio device-state report contract (ADR-0018): Zod schema, generated JSON Schema, and the standalone offline validator CLI.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "netplan-validate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup && tsx src/generate-schema.ts",
    "generate:schema": "tsx src/generate-schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
