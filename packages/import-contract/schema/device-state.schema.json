{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "hosts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "minLength": 1
          },
          "hostname": {
            "type": "string",
            "minLength": 1
          },
          "os": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "kernel": {
                "type": "string"
              }
            },
            "required": ["name"],
            "additionalProperties": false
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": ["ethernet", "wifi", "virtual", "loopback", "other"]
                },
                "mac": {
                  "type": "string"
                },
                "addresses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "type": "string",
                        "enum": ["mac", "ipv4", "ipv6", "hostname"]
                      },
                      "prefixLength": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 128
                      }
                    },
                    "required": ["value"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["name", "addresses"],
              "additionalProperties": false
            }
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "destination": {
                  "type": "string",
                  "minLength": 1
                },
                "gateway": {
                  "type": "string"
                },
                "interface": {
                  "type": "string"
                },
                "metric": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": ["destination"],
              "additionalProperties": false
            }
          },
          "arp": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ip": {
                  "type": "string",
                  "minLength": 1
                },
                "mac": {
                  "type": "string",
                  "minLength": 1
                },
                "interface": {
                  "type": "string"
                }
              },
              "required": ["ip", "mac"],
              "additionalProperties": false
            }
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "protocol": {
                  "type": "string",
                  "enum": ["tcp", "udp", "icmp", "other"]
                },
                "localAddress": {
                  "type": "string",
                  "minLength": 1
                },
                "localPort": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "remoteAddress": {
                  "type": "string",
                  "minLength": 1
                },
                "remotePort": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "state": {
                  "type": "string"
                },
                "process": {
                  "type": "string"
                },
                "pid": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": ["protocol", "localAddress", "localPort", "remoteAddress", "remotePort"],
              "additionalProperties": false
            }
          },
          "listeningPorts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "protocol": {
                  "type": "string",
                  "enum": ["tcp", "udp", "icmp", "other"]
                },
                "address": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "process": {
                  "type": "string",
                  "minLength": 1
                },
                "pid": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": ["protocol", "port", "process"],
              "additionalProperties": false
            }
          },
          "localUsers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "disabled": {
                  "type": "boolean"
                },
                "serviceAccount": {
                  "type": "boolean"
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "localGroups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "members": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": ["name", "members"],
              "additionalProperties": false
            }
          },
          "administrators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sudoers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "collection": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "context": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["context", "message"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["scope", "errors"],
            "additionalProperties": false
          },
          "processes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string"
                },
                "pid": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "parentPid": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "commandLine": {
                  "type": "string"
                },
                "user": {
                  "type": "string"
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string"
                },
                "publisher": {
                  "type": "string"
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "persistence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": ["type", "name"],
              "additionalProperties": false
            }
          },
          "scheduledTasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "schedule": {
                  "type": "string"
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "displayName": {
                  "type": "string"
                },
                "binaryPath": {
                  "type": "string"
                },
                "startMode": {
                  "type": "string"
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "startupEntries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "command": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "shares": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": {}
            }
          },
          "remoteAccess": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string"
                },
                "publisher": {
                  "type": "string"
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "fileInventory": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string"
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": ["path"],
              "additionalProperties": false
            }
          },
          "dns": {
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        "required": [
          "deviceId",
          "hostname",
          "os",
          "collectedAt",
          "interfaces",
          "routes",
          "arp",
          "connections",
          "listeningPorts",
          "localUsers",
          "localGroups",
          "administrators",
          "sudoers",
          "collection"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "hosts"],
  "additionalProperties": false
}
